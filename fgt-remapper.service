[Unit]
Description=Thrustmaster FGT Wheel Remapper
After=graphical-session.target

[Service]
# REPLACE '/path/to/...' with the actual path to your script
ExecStart=/usr/bin/python3 /path/to/steering-wheel-driver/src/fgt_remapper.py --mode xbox
Restart=always
RestartSec=5

[Install]
WantedBy=default.target